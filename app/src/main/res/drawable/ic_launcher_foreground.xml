<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground layer of the adaptive launcher icon, derived from
     docs/assets/bilibili-trace-logo.svg.

     The SVG's 512x560 artwork (TV mascot + clock, text and drop shadow
     removed) is scaled by 0.147 and centered on 54,54 so every extreme
     point stays inside the 66dp safe-zone circle (verified: outer corner
     32.5, antenna caps 31.5, clock top 28.3, feet 31.5). The logo's
     linear gradient is flattened to solid #1680DB. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="16.37"
        android:translateY="21.51"
        android:scaleX="0.147"
        android:scaleY="0.147">
        <!-- Antennas -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1680DB"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:pathData="M188,87 L150,48 M324,87 L362,48" />
        <!-- TV body (rounded rect, stroke centered like the SVG) -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1680DB"
            android:strokeWidth="29"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M122,94 H390 A58,58 0 0 1 448,152 V340 A58,58 0 0 1 390,398 H122 A58,58 0 0 1 64,340 V152 A58,58 0 0 1 122,94 Z" />
        <!-- Feet -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1680DB"
            android:strokeWidth="31"
            android:strokeLineCap="round"
            android:pathData="M162,398 L162,395 M350,398 L350,395" />
        <!-- Clock badge: white disc + blue ring -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M256,34 A65,65 0 1 0 256,164 A65,65 0 1 0 256,34 Z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1680DB"
            android:strokeWidth="11"
            android:pathData="M256,34 A65,65 0 1 0 256,164 A65,65 0 1 0 256,34 Z" />
        <!-- Clock ticks and hands -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1680DB"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M256,55 L256,63 M256,135 L256,143 M213,99 L221,99 M291,99 L299,99" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1680DB"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M256,74 L256,99 L279,112" />
        <!-- Sleepy eyes -->
        <path
            android:fillColor="#1680DB"
            android:pathData="M140,188 L211,166 L219,194 L148,216 Z M301,166 L372,188 L364,216 L293,194 Z" />
        <!-- Smiling moustache -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1680DB"
            android:strokeWidth="15"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M202,253 C219,278 245,278 256,253 C267,278 293,278 310,253" />
    </group>
</vector>
